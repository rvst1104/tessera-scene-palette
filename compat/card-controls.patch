@@ -488,6 +488,33 @@ static void card_state(OpenCard &open, bool force) {
   open.card->on_state(doc.as<JsonObjectConst>());
 }
 
+static bool in_card(lv_obj_t *object) {
+  if (!shown) return false;
+  for (auto *parent = object; parent; parent = lv_obj_get_parent(parent))
+    if (parent == shown->root) return true;
+  return false;
+}
+
+static void control_event(lv_event_t *event) {
+  auto *object = static_cast<lv_obj_t *>(lv_event_get_current_target(event));
+  if (!in_card(object) || lv_obj_has_state(object, LV_STATE_DISABLED)) return;
+  lv_point_t point;
+  if (!rt::finger_at(point) || !lv_obj_hit_test(object, &point)) return;
+  const auto id = static_cast<uint16_t>(reinterpret_cast<uintptr_t>(lv_event_get_user_data(event)));
+  if (!rt::allowed(esphome::millis(), 200000 + id, "plugin card control")) return;
+  OpenCard *open = shown;
+  call(open, [&](tessera::Card &card) { card.on_control(id); });
+}
+
+void register_control(lv_obj_t *object, uint16_t id) {
+  if (!object || !in_card(object)) return;
+  lv_obj_remove_flag(object, LV_OBJ_FLAG_EVENT_BUBBLE);
+  lv_obj_add_flag(object, LV_OBJ_FLAG_CLICKABLE);
+  lv_obj_remove_event_cb(object, control_event);
+  lv_obj_add_event_cb(object, control_event, LV_EVENT_SHORT_CLICKED,
+                      reinterpret_cast<void *>(static_cast<uintptr_t>(id)));
+}
+
 bool card_open() { return shown != nullptr; }
 
 void close_card() {
