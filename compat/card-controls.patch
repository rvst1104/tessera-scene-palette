+        fields = dict(id='scene_1', kind='entity', label='tile', domains=['scene'])
+        self.assertFalse(pm.check(manifest(inputs=[fields]), ENGLISH)['inputs'][0]['optional'])
+        self.assertTrue(pm.check(manifest(inputs=[dict(fields, optional=True)]), ENGLISH)['inputs'][0]['optional'])
